rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /properties/{propertyId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /arrangements/{arrangementId} {
      allow read, write: if true;
    }

    match /threads/{threadId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
